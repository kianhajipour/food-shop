<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<StackPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegesterController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="18.0" prefWidth="111.0" text="نام کاربری" />
            <TextField fx:id="userName" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="214.0" />
            <Label text="شماره تلفن" />
            <TextField fx:id="num" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="213.0" />
            <HBox alignment="CENTER" prefHeight="34.0" prefWidth="600.0">
               <children>
                  <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#enter" styleClass="login-btn" text="ثبت نام">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#back" text="بازگشت">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            <Label fx:id="log" alignment="CENTER" contentDisplay="CENTER" prefHeight="84.0" prefWidth="240.0">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </children>
</StackPane>
